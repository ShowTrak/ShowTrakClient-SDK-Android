<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is the only permission the SDK needs. Library manifests merge
         into the consuming app, so anything declared here is a permission every
         integrator inherits whether they use it or not. -->
    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
